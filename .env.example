# Application
APP_NAME=AI Healthcare Assistant
APP_ENV=development
APP_DEBUG=true
SECRET_KEY=change-me-to-a-long-random-secret-key-in-production
ENCRYPTION_KEY=
PHI_MASKING_ENABLED=true
TLS_ENABLED=false
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:8911,http://127.0.0.1:8911

# Ports
FRONTEND_PORT=8911
BACKEND_PORT=8000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=healthcare
POSTGRES_PASSWORD=healthcare_secret
POSTGRES_DB=ai_healthcare

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=healthcare_neo4j

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# LLM Providers (set at least one)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4o-mini
DEFAULT_EMBEDDING_PROVIDER=openai
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small

# OCR / Whisper
WHISPER_MODEL=base
OCR_ENGINE=tesseract

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# Monitoring
PROMETHEUS_ENABLED=true
LOG_LEVEL=INFO
ELASTICSEARCH_URL=http://localhost:9200

# n8n
N8N_WEBHOOK_URL=http://localhost:5678/webhook
